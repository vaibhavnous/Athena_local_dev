# Copy to .env and fill with your own values.
# Do NOT commit the real .env file.

# Local dev vector search uses Pinecone plus Azure/OpenAI embeddings.
# Legacy/global indexes remain supported for existing runs.
# PINECONE_API_KEY=
# PINECONE_INDEX_NAME=
# PINECONE_ENVIRONMENT=
# PINECONE_SCHEMA_INDEX_NAME=
# PINECONE_KNOWLEDGE_BASE_INDEX_NAME=knowledgebase
PINECONE_INSURANCE_KB_INDEX_NAME=insurancekb
PINECONE_BASEL_KB_INDEX_NAME=beselkb
DATABRICKS_KB_SOURCE_TABLE=workspace.athena.domain_kb_pinecone_migration_vw

# Optional domain knowledge base. Runtime flag defaults off.
ATHENA_USE_DOMAIN_KB=false
ATHENA_KB_ID=PC_Insurance_V1
ATHENA_DOMAIN_PROFILE=Insurance
ATHENA_KB_TOP_K_ENRICHMENT=8
ATHENA_KB_TOP_K_GOLD=10
ATHENA_KB_MAX_CHARS_ENRICHMENT=4000
ATHENA_KB_MAX_CHARS_GOLD=5000

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_MODEL=gpt-4.1
AZURE_OPENAI_EMBEDDING_API_KEY=
AZURE_OPENAI_EMBEDDING_ENDPOINT=
AZURE_OPENAI_EMBEDDING_API_VERSION=2024-12-01-preview
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional app settings
ATHENA_DEMO_MODE=false
ATHENA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Authentication (required; never commit real values)
# Set true only for the public marketplace demo. Login remains enabled by default.
ATHENA_AUTH_DISABLED=false
ASTRA_AUTH_EMAIL=
ASTRA_AUTH_USERNAME=
ASTRA_AUTH_PASSWORD=
ASTRA_JWT_SECRET=
ASTRA_JWT_EXPIRES_IN_SECONDS=3600
ASTRA_JWT_ISSUER=astra-api
ASTRA_JWT_AUDIENCE=astra-frontend
ATHENA_BLOCK_EMBEDDINGS=false
ATHENA_ENABLE_EMBEDDINGS=true
ATHENA_PRELOAD_EMBEDDINGS=false
ATHENA_ALLOW_LOCAL_EMBEDDING_FALLBACK=false
ATHENA_EMBEDDING_PRELOAD_REQUIRED=false
HF_HOME=
SENTENCE_TRANSFORMERS_HOME=
DEV_MODE=false
LOGTAIL_TOKEN=
ATHENA_APP_DATA_DIR=/home/site/data
ATHENA_GENERATED_CODE_DIR=
# Generated scripts only. Pipeline state, checkpoints, and metadata records remain in Azure SQL.
ATHENA_ADLS_CODE_ROOT=
ATHENA_UPLOAD_DIR=
ATHENA_PIPELINE_LOG_FILE=
ATHENA_MARK_INTERRUPTED_RUNS_ON_STARTUP=true
ATHENA_INTERRUPTED_RUN_RECOVERY_LIMIT=50
ATHENA_BACKGROUND_WORKERS=1
BRONZE_MAX_WORKERS=3
SILVER_MAX_WORKERS=3
COLUMN_PROFILING_MAX_WORKERS=3
GUNICORN_TIMEOUT_SECONDS=600

# Optional compliance assessment backend. Enabled per run with compliance_enabled=true.
COMPLIANCE_BACKEND_URL=https://astra-compliance-hhgxb8hshua7ftdc.southindia-01.azurewebsites.net
COMPLIANCE_REQUEST_TIMEOUT_SECONDS=300
COMPLIANCE_MAX_METADATA_COLUMNS=50
COMPLIANCE_BACKGROUND_WORKERS=2
COMPLIANCE_DOMAIN=Insurance
COMPLIANCE_COUNTRIES=US

# Azure SQL (pipeline DB where ai_store / kpi_checkpoints / hitl_review_queue live)
AZURE_SQL_HOST=
AZURE_SQL_PORT=1433
AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server
AZURE_SQL_CONNECTION_TIMEOUT=5

# Connection retry policy (keep small for local dev)
ATHENA_SQL_CONNECT_RETRIES=1
ATHENA_SQL_CONNECT_RETRY_DELAY_SECONDS=1
# Minimum visibility for automatic phase 1-2 stages. Reviews and column profiling are excluded; 0 disables it.
ATHENA_MIN_STAGE_RUNTIME_SECONDS=10
ATHENA_RUNS_ENDPOINT_TIMEOUT_SECONDS=5
ATHENA_RUNS_LIST_LIMIT=25
ATHENA_SQL_QUERY_TIMEOUT_SECONDS=5
AZURE_SQL_ENCRYPT=yes
AZURE_SQL_TRUST_SERVER_CERTIFICATE=no
AZURE_SQL_CONNECTION_TIMEOUT=30
ATHENA_SQL_TCP_PROBE_TIMEOUT_SECONDS=10
ATHENA_SQL_TCP_PROBE_ENABLED=false
ATHENA_SQL_FAIL_FAST_ON_TCP_PROBE=false
AZURE_SQL_PIPELINE_DATABASE=
AZURE_SQL_PIPELINE_SCHEMA=metadata
AZURE_SQL_USERNAME=
AZURE_SQL_PASSWORD=

# Azure SQL (source/client DB that contains the business tables)
AZURE_SQL_SOURCE_HOST=
AZURE_SQL_SOURCE_DATABASE=
AZURE_SQL_SOURCE_SCHEMA=dbo
AZURE_SQL_SOURCE_USERNAME=
AZURE_SQL_SOURCE_PASSWORD=

# Snowflake Bronze execution (off by default; generation still works without these)
# Target-resident metadata control plane. Fabric remains fail-fast until its
# Warehouse/Lakehouse execution substrate is selected.
DATABRICKS_SQL_WAREHOUSE_ID=
ATHENA_TARGET_ENVIRONMENT=qa
ATHENA_DATABRICKS_METADATA_CATALOG=
ATHENA_SNOWFLAKE_METADATA_DATABASE=
ATHENA_METADATA_SCHEMA=metadata_schema
# Temporary design-time fallback only. Runtime execution still requires an active metadata connection.
ATHENA_METADATA_ALLOW_ENV_SOURCE_FALLBACK=false
DATABRICKS_SOURCE_SECRET_SCOPE=dataedge-secrets
DATABRICKS_SOURCE_USERNAME_SECRET_KEY=azure-sql-username
DATABRICKS_SOURCE_PASSWORD_SECRET_KEY=azure-sql-password
# ADLS Bronze serverless bridge. Approved source files are copied here only at execution time.
DATABRICKS_ADLS_BRONZE_VOLUME=/Volumes/workspace/bronze_schema/vol_bronze
ATHENA_ADLS_VOLUME_UPLOAD_WORKERS=4

ATHENA_EXECUTE_SNOWFLAKE_BRONZE=false
ATHENA_EXECUTE_SNOWFLAKE_SILVER=false
ATHENA_EXECUTE_SNOWFLAKE_GOLD=false
ATHENA_SNOWFLAKE_BRONZE_LOAD_SOURCE=false
ATHENA_SNOWFLAKE_BRONZE_SOURCE_MODE=azure_sql
# Optional safety filter for Snowflake Bronze generation.
# Leave unset or use "*" to generate scripts for the pipeline-selected tables.
ATHENA_SNOWFLAKE_BRONZE_TABLE_ALLOWLIST=*
SNOWFLAKE_BRONZE_CATALOG=ATHENA_DB
SNOWFLAKE_BRONZE_SCHEMA=BRONZE
# Optional dbt source-landing schema. Unset preserves the legacy behavior of landing raw_* in Bronze.
SNOWFLAKE_RAW_SCHEMA=RAW
SNOWFLAKE_SILVER_CATALOG=ATHENA_DB
SNOWFLAKE_SILVER_SCHEMA=SILVER
SNOWFLAKE_GOLD_CATALOG=ATHENA_DB
SNOWFLAKE_GOLD_SCHEMA=GOLD
ATHENA_GOLD_MAX_SOURCE_TABLES=3
ATHENA_GOLD_MAX_DIMENSION_TABLES=2
# Databricks Gold runtime quality gates. Set source age to 0 when no freshness SLA is certified.
ATHENA_GOLD_MAX_MEASURE_NULL_RATIO=0.2
ATHENA_GOLD_MAX_DIMENSION_CARDINALITY=1000000
ATHENA_GOLD_MAX_SOURCE_AGE_DAYS=0
ATHENA_GOLD_MAX_JOIN_MULTIPLIER=1.05
ATHENA_SNOWFLAKE_RESUME_WAIT_SECONDS=300
ATHENA_SNOWFLAKE_BRONZE_SOURCE_LOAD_LIMIT=0
ATHENA_SNOWFLAKE_BRONZE_BATCH_SIZE=10000
ATHENA_SNOWFLAKE_NATIVE_WORKERS=4
ATHENA_SNOWFLAKE_ADLS_INSERT_BATCH_SIZE=1000
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=
# Snowflake-native dbt Projects. The project object is stored separately from
# model outputs; model database/schema targets remain the Bronze/Silver/Gold values above.
SNOWFLAKE_DBT_ROLE=ATHENA_DBT_ROLE
SNOWFLAKE_DBT_PROJECT_DATABASE=ATHENA_DB
SNOWFLAKE_DBT_PROJECT_SCHEMA=PUBLIC
ATHENA_SNOWFLAKE_DBT_TARGET_NAME=dev
ATHENA_SNOWFLAKE_DBT_THREADS=4
ATHENA_SNOWFLAKE_DBT_COMMAND_TIMEOUT_SECS=1800
# Optional when the Snowflake CLI launcher is not available on PATH (common on Windows):
# ATHENA_SNOWFLAKE_CLI_COMMAND=C:\path\to\python.exe -m snowflake.cli._app.__main__
SNOWFLAKE_ADLS_INTEGRATION=ADLS_INSURANCE_INT
SNOWFLAKE_ADLS_STAGE_DB=ATHENA_DB
SNOWFLAKE_ADLS_STAGE_SCHEMA=BRONZE
SNOWFLAKE_ADLS_STAGE_NAME=ADLS_INSURANCE_STAGE
SNOWFLAKE_ADLS_STAGE_URL=azure://atheastorage.blob.core.windows.net/athena/Insurance/
SNOWFLAKE_ADLS_FILE_FORMAT=ADLS_CSV_FORMAT

# ADLS-source Snowflake stage. Kept separate from database-source stage settings.
ADLS_FLOW_BRONZE_SOURCE_MODE=adls
ADLS_FLOW_STAGE_DB=INSURANCE
ADLS_FLOW_STAGE_SCHEMA=BRONZE
ADLS_FLOW_STAGE_NAME=SFTP_INSURANCE_CSV
ADLS_FLOW_STAGE_URL=azure://atheastorage.blob.core.windows.net/athena/INSURANCE_SFTP/insurance/
ADLS_FLOW_STAGE_FORMAT=INSURANCE_CSV
ADLS_FLOW_SAS_TOKEN=

# ADLS Python/service-principal source mode.
# Use ATHENA_SNOWFLAKE_BRONZE_SOURCE_MODE=adls_python to load files through backend Python.
ADLS_ACCOUNT_URL=https://atheastorage.dfs.core.windows.net
ADLS_FILE_SYSTEM=athena
ADLS_SOURCE_ROOT=evention/vendor1/machine1
ADLS_PREFIX=evention/vendor1/machine1
ADLS_VENDOR_ROOT=evention/vendor1/machine1
ADLS_VENDOR_NAME=Vendor1

# Azure Key Vault application secrets. Keep disabled for local development unless
# the signed-in identity or service principal has Secrets/Get permission.
ATHENA_KEY_VAULT_ENABLED=false
AZURE_KEY_VAULT_URL=https://astra-dev.vault.azure.net/
# These three settings bootstrap service-principal authentication and therefore
# cannot be loaded from this same vault. If omitted, managed identity is used.
# Expected vault secrets: az-astra-data-username, az-astra-data-pwd,
# az-src-insurance-username, az-src-insurance-pwd, AZURE-OPENAI-API-KEY,
# AZURE-OPENAI-EMBEDDING-API-KEY, DATABRICKS-TOKEN, PINECONE-API-KEY,
# SNOWFLAKE-ACCOUNT, SNOWFLAKE-PASSWORD, and SNOWFLAKE-USER.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Optional ADLS discovery, schema sampling, and Silver merge-key limits.
ADLS_MAX_DISCOVERED_FILES=10000
ADLS_SCHEMA_SAMPLE_BYTES=4194304
ADLS_SCHEMA_SAMPLE_ROWS=1000
ADLS_MERGE_KEY_MAX_CANDIDATE_COLUMNS=14
ADLS_MERGE_KEY_MAX_WIDTH=4
ADLS_MERGE_KEY_MAX_VALIDATED_CANDIDATES=32
ADLS_MERGE_KEY_MIN_SAMPLE_UNIQUENESS=0.98
ADLS_MERGE_KEY_MIN_SAMPLE_COMPLETENESS=1.0

# Optional ADLS Silver merge-key LLM overrides. The provider falls back to
# ATHENA_LLM_PROVIDER and the model falls back to AZURE_OPENAI_DEPLOYMENT.
ATHENA_ADLS_MERGE_KEY_LLM_PROVIDER=azure_openai
ATHENA_ADLS_MERGE_KEY_LLM_MODEL=
ATHENA_ADLS_MERGE_KEY_LLM_TIMEOUT_SECONDS=45
ADLS_MERGE_KEY_LLM_ATTEMPTS=3

# Optional LLM-assisted Silver/Gold code generation. Outputs are validated and
# fall back to deterministic generators when disabled or unavailable.
ATHENA_SILVER_USE_LLM=false
ATHENA_GOLD_USE_LLM=false
ATHENA_SILVER_LLM_PROVIDER=azure_openai
ATHENA_GOLD_LLM_PROVIDER=azure_openai
